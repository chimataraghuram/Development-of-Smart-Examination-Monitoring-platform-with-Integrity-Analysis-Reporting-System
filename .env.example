# Copy this file to .env and set a valid OpenRouter credential locally.
# Never commit the resulting .env file.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Optional: OpenRouter model slug. The default uses OpenRouter's automatic router.
OPENROUTER_MODEL=openrouter/auto

# Optional: deployed application URL used for provider attribution.
APP_URL=http://localhost:5000
