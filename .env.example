# Copy this file to .env and set a valid OpenRouter credential locally.
# Never commit the resulting .env file.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# Optional: OpenRouter model slug. The default uses OpenRouter's automatic router.
OPENROUTER_MODEL=openrouter/auto

# Optional: deployed application URL used for provider attribution.
APP_URL=http://localhost:5000

# Session and local development settings.
FLASK_SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
ADMIN_DEFAULT_PASSWORD=replace_with_a_strong_admin_password
